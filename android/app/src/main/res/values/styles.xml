<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="JetstreamTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>
    <!-- Cold-start splash: painted by the system before any code runs -->
    <style name="JetstreamTheme.Splash">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
